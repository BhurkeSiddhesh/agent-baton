# Generated by Agent Baton. GitHub expressions are written as $[[ ... ]] in the template and converted on install.
name: baton

on:
  pull_request:
  push:
    branches: [main]

permissions:
  contents: read

jobs:
  check:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          fetch-depth: 0
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4
        with:
          node-version: 20
      - name: Plan, ownership and ledger check
        run: {{cli}} check
      - name: Resolve packet from branch name
        id: packet
        if: startsWith(github.head_ref, 'baton/')
        env:
          HEAD_REF: $[[ github.head_ref ]]
        run: |
          node -e '
            const fs = require("fs");
            const ref = process.env.HEAD_REF.replace(/^baton\//, "");
            const plan = JSON.parse(fs.readFileSync(".baton/plan.json", "utf8"));
            const ids = plan.packets.map((p) => p.id).filter((id) => ref === id || ref.startsWith(id + "-") || ref.startsWith(id + "/"));
            ids.sort((a, b) => b.length - a.length);
            fs.appendFileSync(process.env.GITHUB_OUTPUT, "id=" + (ids[0] || "") + "\n");
          '
      - name: Scope guard and secret scan
        if: steps.packet.outputs.id != ''
        env:
          PACKET: $[[ steps.packet.outputs.id ]]
        run: {{cli}} verify "$PACKET" --no-tests
{{#if testCommand}}
      - name: Tests
        if: steps.packet.outputs.id != ''
        run: {{testCommand}}
{{/if}}
      - name: Render job summary
        if: always()
        run: |
          {{cli}} render --out .baton/views
          cat .baton/views/STATUS.md >> "$GITHUB_STEP_SUMMARY"
