# Generated by Agent Baton. GitHub expressions are written as $[[ ... ]] in the template and converted on install.
# Issues created by `{{cli}} dispatch <packet>` carry the label "baton". This workflow adds instructions for cloud agents.
name: baton-dispatch

on:
  issues:
    types: [labeled]

concurrency:
  group: baton-dispatch-$[[ github.event.issue.number ]]
  cancel-in-progress: false

permissions:
  issues: write

jobs:
  instructions:
    if: github.event.label.name == 'baton'
    runs-on: ubuntu-latest
    steps:
      - name: Comment cloud agent instructions
        env:
          GH_TOKEN: $[[ github.token ]]
          ISSUE: $[[ github.event.issue.number ]]
          REPO: $[[ github.repository ]]
        run: |
          cat > body.md <<'BODY'
          Agent Baton packet issue. A cloud agent (Copilot, Claude, Codex) picking this up must:

          1. Read AGENTS.md and the packet brief in this issue.
          2. Run `{{cli}} check`, then `{{cli}} begin <packet> --agent <your agent id> --pull`.
          3. Edit only the files listed in the packet `owns`. Request anything else with `{{cli}} bus post --from <your agent id> --type REQUEST --text "..."`.
          4. Run `{{cli}} verify <packet>`, then `{{cli}} submit <packet> --agent <your agent id> --note "..."`.
          5. Open a pull request from a `baton/<packet>` branch and paste the verify output into it.
          BODY
          gh issue comment "$ISSUE" --repo "$REPO" --body-file body.md
