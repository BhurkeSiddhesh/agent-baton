      "onlyIfAbsent": true
    },
    {
      "src": "docs/ORCHESTRATION.md.tpl",
      "dest": "docs/BATON.md",
      "each": null,
      "mode": "file",
      "when": "docs"
    }
  ],
  "postprocessors": {
    "github-expressions": {
      "description": "After rendering, replace every $[[ expr ]] with ${{ expr }}. The template engine reserves double braces, so GitHub expressions are written with square brackets.",
      "pattern": "\\$\\[\\[([\\s\\S]*?)\\]\\]",
      "replacement": "${{$1}}"
    }
  },
  "planStarter": "plan.starter.json"
}
